datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Recording {
  id        String   @id @default(uuid())
  sessionId String?
  url       String?
  events    String
  createdAt DateTime @default(now())

  runs       TestRun[]
  executions TestExecution[]
}

model TestRun {
  id          String @id @default(uuid())
  recordingId String

  recording Recording @relation(fields: [recordingId], references: [id])

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  success    Boolean
  steps      String
}

model TestExecution {
  id          String @id @default(uuid())
  recordingId String

  recording Recording @relation(fields: [recordingId], references: [id])

  status      String
  healedCount Int
  duration    Float
  logs        String

  createdAt DateTime @default(now())
}
