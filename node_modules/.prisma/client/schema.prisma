datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Recording {
  id          String          @id @default(uuid())
  sessionId   String?
  url         String?
  events      String
  createdAt   DateTime        @default(now())
  userId      String
  workspaceId String
  user        User            @relation(fields: [userId], references: [id])
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  runs        TestRun[]
  executions  TestExecution[]

  @@index([userId])
  @@index([workspaceId])
}

model TestRun {
  id          String    @id @default(uuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id])
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  success     Boolean
  steps       String
  workspaceId String?
}

model TestExecution {
  id            String    @id @default(uuid())
  recordingId   String
  recording     Recording @relation(fields: [recordingId], references: [id])
  status        String
  healedCount   Int
  duration      Float
  logs          String
  provider      String? // Jenkins / GitHub / GitLab
  branch        String? // main / develop
  environment   String? // staging / production
  commitHash    String?
  repository    String?
  workflowName  String?
  actor         String?
  commitMessage String?
  buildNumber   String?
  workspaceId   String?
  createdAt     DateTime  @default(now())
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  password        String?
  avatar          String?
  createdAt       DateTime          @default(now())
  memberships     WorkspaceMember[]
  recordings      Recording[]
  ownedWorkspaces Workspace[]
}

model Workspace {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  createdAt  DateTime          @default(now())
  ownerId    String
  owner      User              @relation(fields: [ownerId], references: [id])
  members    WorkspaceMember[]
  recordings Recording[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}
