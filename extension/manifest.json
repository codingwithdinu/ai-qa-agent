{
  "manifest_version": 3,

  "name": "AI QA Recorder",

  "version": "1.0",

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "https://ai-qa-agent-rho.vercel.app/*"
    ]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}